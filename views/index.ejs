
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TechDesk | IT Incident Tracker</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <header class="navbar">
    <a href="/" class="brand">
      <img src="/images/techdesk-logo.png" alt="TechDesk Logo">
