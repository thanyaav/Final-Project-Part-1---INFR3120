
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>View Incidents | TechDesk</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <header class="navbar">
    <a href="/" class="brand">
      <img src="/images/techdesk-logo.png" alt="TechDesk Logo">
      <span>TechDesk</span>
    </a>

    <nav>
      <a href="/">Home</a>
      <a href="/incidents">View Incidents</a>
      <a href="/incidents/new">Create Incident</a>
    </nav>
  </header>

  <main class="overview">
    <h1>Incident Dashboard</h1>
    <p>View all reported IT incidents.</p>

    <table border="1">
      <tr>
        <th>Title</th>
        <th>Description</th>
        <th>Priority</th>
        <th>Status</th>
      </tr>

      <% for (let i = 0; i < incidents.length; i++) { %>
        <tr>
          <td><%= incidents[i].title %></td>
          <td><%= incidents[i].description %></td>
          <td><%= incidents[i].priority %></td>
          <td><%= incidents[i].status %></td>
        </tr>
      <% } %>
    </table>

    <a href="/incidents/new" class="btn">+ Create New Incident</a>
  </main>

  <footer>
    <p>TechDesk | INFR3120 Project Part 1</p>
  </footer>

</body>
</html>